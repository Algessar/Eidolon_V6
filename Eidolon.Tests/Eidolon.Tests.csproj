        <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\EidolonCore\EidolonCore.csproj" />
        <ProjectReference Include="..\Vulkan\Vulkan.csproj" />
    </ItemGroup>

